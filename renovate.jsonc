{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // The Wasm tests run on @willbooster/web-tree-sitter, and the Rust tests, the fuzz job, and the CLI that
      // script/tree-sitter runs on willbooster-tree-sitter, the same runtime, so they are updated together.
      "matchPackageNames": ["@willbooster/web-tree-sitter", "willbooster-tree-sitter"],
      "groupName": "tree-sitter",
    },
    {
      // The preset exempts @willbooster npm packages, including @willbooster/web-tree-sitter, from its release-age
      // gate but not this crate, which is released from the same commit; without this rule the grouped update would
      // bump the npm runtime a week before the crate.
      "matchDatasources": ["crate"],
      "matchPackageNames": ["willbooster-tree-sitter"],
      "minimumReleaseAge": "0 days",
    },
    // 22.0.1: Version 22 introduces declaration keyword external scanner tokens that the TypeScript scanner does not implement; adopting it requires adapting the scanner and grammar integration (https://github.com/WillBooster/tree-sitter-javascript/pull/164, https://github.com/WillBooster/tree-sitter-typescript/pull/181). No newer release is available.
    {
      "matchPackageNames": ["@willbooster/tree-sitter-javascript"],
      "allowedVersions": "!/^22\\.0\\.1$/",
    },
  ],
}

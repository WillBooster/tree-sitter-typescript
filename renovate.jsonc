{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>WillBooster/willbooster-configs:renovate.jsonc"],
  "packageRules": [
    {
      // The Wasm tests run on @willbooster/web-tree-sitter, and the Rust tests, the fuzz job, and the CLI that
      // script/tree-sitter runs on willbooster-tree-sitter, the same runtime, so they are updated together.
      "matchPackageNames": ["@willbooster/web-tree-sitter", "willbooster-tree-sitter"],
      "groupName": "tree-sitter",
    },
    {
      // The preset exempts @willbooster npm packages, including @willbooster/web-tree-sitter, from its release-age
      // gate but not this crate, which is released from the same commit; without this rule the grouped update would
      // bump the npm runtime a week before the crate.
      "matchDatasources": ["crate"],
      "matchPackageNames": ["willbooster-tree-sitter"],
      "minimumReleaseAge": "0 days",
    },
    // 16.0.0: Version 16.0.0 exhibits quadratic Wasm memory growth on ambiguous TypeScript and TSX input with this grammar, risking host termination: https://github.com/WillBooster/tree-sitter/issues/323. Version 16.0.1 fixes a separate callback issue, not this report: https://github.com/WillBooster/tree-sitter/pull/324.
    {
      "matchPackageNames": ["@willbooster/web-tree-sitter"],
      "allowedVersions": "!/^16\\.0\\.0$/",
    },
    // 16.0.0: The Cargo package is willbooster-tree-sitter, locked at 15.5.4 before this update. Its version must match the web runtime, which is reverted because of https://github.com/WillBooster/tree-sitter/issues/323; keeping 16 would violate the existing runtime pairing: https://github.com/WillBooster/tree-sitter-typescript/pull/27.
    {
      "matchPackageNames": ["tree-sitter"],
      "allowedVersions": "!/^16\\.0\\.0$/",
    },
  ],
}

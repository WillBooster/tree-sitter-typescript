{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "typescript",
      "camelcase": "TypeScript",
      "scope": "source.ts",
      "path": "typescript",
      "external-files": ["common/scanner.h", "common/typeScriptKeywords.h", "common/functionContext.h"],
      "file-types": ["ts"],
      "injection-regex": "^(ts|typescript)$"
    },
    {
      "name": "tsx",
      "camelcase": "TSX",
      "scope": "source.tsx",
      "path": "tsx",
      "external-files": ["common/scanner.h", "common/typeScriptKeywords.h", "common/functionContext.h"],
      "file-types": ["tsx"],
      "injection-regex": "^(ts|typescript)$"
    },
    {
      "name": "flow",
      "camelcase": "Flow",
      "scope": "source.js.flow",
      "path": "tsx",
      "external-files": ["common/scanner.h", "common/typeScriptKeywords.h", "common/functionContext.h"],
      "file-types": ["js"],
      "content-regex": "@flow"
    }
  ],
  "metadata": {
    "version": "0.23.2",
    "license": "MIT",
    "description": "TypeScript and TSX grammars for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-typescript"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}

#!/usr/bin/env bash

# Copies the queries of @willbooster/tree-sitter-javascript, which this grammar extends, into queries/javascript/: the
# published tree-sitter.json can reference only files inside this package.

set -euo pipefail

cd "$(dirname "$0")/.."
rm -rf queries/javascript
mkdir -p queries/javascript
for file in highlights.scm highlights-jsx.scm injections.scm locals.scm tags.scm; do
  cp "node_modules/@willbooster/tree-sitter-javascript/queries/$file" queries/javascript/
done

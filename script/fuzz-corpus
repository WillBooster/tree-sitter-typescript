#!/usr/bin/env bash

# Runs `tree-sitter fuzz` for the given grammar (`typescript` or `tsx`): it edits each corpus case of that grammar at
# random, reparses it incrementally, undoes the edits, and reparses again, on the runtime that script/tree-sitter runs.

set -euo pipefail

grammar=$1
cd "$(dirname "$0")/.."

mkdir -p .tmp/fuzz
parser=$(mktemp ".tmp/fuzz/$grammar.XXXXXX")
trap 'rm -f "$parser"' EXIT
script/tree-sitter build -o "$parser" "$grammar"
script/tree-sitter fuzz --lib-path "$parser" --lang-name "$grammar"

#!/usr/bin/env bash

# Runs `tree-sitter fuzz` for the given grammar (`typescript` or `tsx`): it edits each corpus case of that grammar at
# random, reparses it incrementally, undoes the edits, and reparses again. The CLI comes from WillBooster/tree-sitter at
# the willbooster-tree-sitter version in Cargo.lock, since the runtime embedded in the upstream CLI never finishes
# recovering from some edited cases. The first run downloads that CLI into .tmp/ from the GitHub Release of the version,
# or builds it when the download fails or the release has no binary that runs here, which takes over 10 minutes on
# GitHub's Intel macOS runner.

set -euo pipefail

grammar=$1
cd "$(dirname "$0")/.."

version=$(awk '/^name = "willbooster-tree-sitter"$/ { getline; gsub(/version = |"/, ""); print }' Cargo.lock)
cli=.tmp/tree-sitter-cli/${version:?Cargo.lock locks no willbooster-tree-sitter}
if [[ ! -x $cli/bin/tree-sitter ]]; then
  case $(uname -s)-$(uname -m) in
    Linux-x86_64) platform=linux-x64 ;;
    Linux-aarch64) platform=linux-arm64 ;;
    Darwin-arm64) platform=macos-arm64 ;;
    Darwin-x86_64) platform=macos-x64 ;;
    *) platform= ;;
  esac
  download=$cli/download
  rm -rf "$download" && mkdir -p "$download" "$cli/bin"
  # A binary that does not run here (e.g. on an older glibc than the release's build) is replaced by a build as well.
  # Without a speed limit, a stalled transfer would hang instead of falling back to the build.
  # The archive is saved before extraction because a retry restarts the transfer, which a pipe into tar cannot undo.
  if [[ -n $platform ]] && curl --fail --silent --show-error --location --retry 3 --speed-limit 1024 --speed-time 60 \
    --output "$download/cli.tar.gz" \
    "https://github.com/WillBooster/tree-sitter/releases/download/v$version/tree-sitter-cli-$platform.tar.gz" &&
    tar -xzf "$download/cli.tar.gz" -C "$download" && "$download/tree-sitter" --version > /dev/null; then
    mv "$download/tree-sitter" "$cli/bin/tree-sitter"
  else
    # The default `qjs-rt` feature only serves `tree-sitter generate`, which stays on the pinned upstream CLI.
    cargo install --quiet --locked --no-default-features --root "$cli" \
      --git https://github.com/WillBooster/tree-sitter --tag "v$version" tree-sitter-cli
  fi
  rm -rf "$download"
fi

mkdir -p .tmp/fuzz
bun run tree-sitter build -o ".tmp/fuzz/$grammar.parser" "$grammar"
"$cli/bin/tree-sitter" fuzz --lib-path ".tmp/fuzz/$grammar.parser" --lang-name "$grammar"
